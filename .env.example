# Database Settings
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=AdventureWorks2022
DB_USER=sa
DB_PASSWORD=ChangeThis_SqlPassword1!
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# Ollama Settings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=30m
WARM_RUNTIME_ON_STARTUP=false
WARM_GENERATION_MODEL_ON_STARTUP=true
WARM_EMBEDDING_MODEL_ON_STARTUP=true
WARMUP_TIMEOUT_SECONDS=15
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
QDRANT_URL=http://qdrant:6333
PHOENIX_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_PROJECT_NAME=enterprise-conversational-agent
TRACE_RESULT_PREVIEW_ROWS=5
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN
AUTH0_AUDIENCE=YOUR_AUTH0_AUDIENCE

# Frontend build-time Auth0 settings. These are public SPA values, but still
# environment-specific and must be set before `docker compose build`.
VITE_AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN
VITE_AUTH0_CLIENT_ID=YOUR_AUTH0_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=YOUR_AUTH0_AUDIENCE

# Request execution timeouts (seconds)
REQUEST_TIMEOUT_SECONDS=120
ROUTER_TIMEOUT_SECONDS=15
TEXT_TO_SQL_TIMEOUT_SECONDS=30
SQL_REPAIR_TIMEOUT_SECONDS=30
ANSWER_GENERATION_TIMEOUT_SECONDS=30
RETRIEVAL_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=20
SQL_EXECUTION_TIMEOUT_SECONDS=60
