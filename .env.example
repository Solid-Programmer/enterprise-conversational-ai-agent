# Database Settings
DB_SERVER=localhost
DB_NAME=AdventureWorks2022
DB_USER=sa
DB_PASSWORD=YourPassword123!
DB_TRUSTED_CONNECTION=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
