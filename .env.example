CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
QDRANT_URL=http://localhost:6333
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=enterprise-conversational-agent
TRACE_RESULT_PREVIEW_ROWS=5
AUTH0_DOMAIN=dev-87zi6krwvcz8sf4z.eu.auth0.com
AUTH0_AUDIENCE=https://enterprise-ai-agent-api

# Request execution timeouts (seconds)
REQUEST_TIMEOUT_SECONDS=120
